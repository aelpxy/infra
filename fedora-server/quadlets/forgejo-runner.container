[Unit]
Description=Forgejo Actions runner
Requires=forgejo-dind.service
After=forgejo-dind.service

[Container]
Image=data.forgejo.org/forgejo/runner:13
ContainerName=forgejo-runner
Network=forgejo-runner.network
Network=forgejo-web.network
UserNS=keep-id:uid=1000,gid=1000
Environment=DOCKER_HOST=tcp://forgejo-dind:2375
Volume=/srv/forgejo-runner/data:/data:Z
WorkingDir=/data
Exec=forgejo-runner daemon --config /data/config.yml
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
