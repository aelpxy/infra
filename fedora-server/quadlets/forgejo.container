[Unit]
Description=Forgejo
Requires=forgejo-db.service
After=forgejo-db.service

[Container]
Image=codeberg.org/forgejo/forgejo:17-rootless
ContainerName=forgejo
UserNS=keep-id:uid=1000,gid=1000
Network=forgejo.network
Network=forgejo-web.network
Volume=/srv/forgejo/data:/var/lib/gitea:Z
Volume=/srv/forgejo/config:/etc/gitea:Z
Volume=/etc/localtime:/etc/localtime:ro
EnvironmentFile=%h/.config/forgejo/forgejo.env
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
