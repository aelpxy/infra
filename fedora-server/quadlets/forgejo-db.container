[Unit]
Description=Forgejo Postgres

[Container]
Image=docker.io/library/postgres:18-alpine
ContainerName=forgejo-db
Network=forgejo.network
Volume=/srv/forgejo/db:/var/lib/postgresql:Z
EnvironmentFile=%h/.config/forgejo/db.env
HealthCmd=pg_isready -U forgejo -d forgejo
HealthInterval=10s
Notify=healthy
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
