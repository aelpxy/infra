<div class="cgit-latest">
	<div class="latest-commit">{{template "repo/latest_commit" .}}</div>
	<span class="cgit-age">{{if .LatestCommit}}{{if .LatestCommit.Committer}}{{DateUtils.TimeSince .LatestCommit.Committer.When}}{{end}}{{end}}</span>
</div>
<table id="repo-files-table" class="cgit-table cgit-tree" {{if .HasFilesWithoutLatestCommit}}hx-indicator="tr.notready td.message span" hx-trigger="load" hx-swap="morph" hx-get="{{.LastCommitLoaderURL}}"{{end}}>
	<caption class="tw-sr-only">{{ctx.Locale.Tr "repo.files.caption"}}</caption>
	<thead>
		<tr>
			<th>Name</th>
			<th>Mode</th>
			<th>Last commit</th>
			<th class="cgit-right">Size</th>
			<th class="cgit-right">Age</th>
		</tr>
	</thead>
	<tbody>
		{{if .HasParentPath}}
			<tr class="has-parent">
				<td colspan="5"><a href="{{.BranchLink}}{{if .ParentPath}}{{PathEscapeSegments .ParentPath}}{{end}}">..</a></td>
			</tr>
		{{end}}
		{{range $item := .Files}}
			{{$entry := $item.Entry}}
			{{$commit := $item.Commit}}
			<tr data-entryname="{{$entry.Name}}" data-ready="{{if $commit}}true{{else}}false{{end}}" class="{{if not $commit}}not{{end}}ready entry">
				<td class="name cgit-name">
					<span class="truncate">
						{{if $entry.IsSubmodule}}
							{{$submodule := $item.Submodule}}
							{{$refURL := $submodule.ResolveUpstreamURL $.Repository.HTMLURL}}
							{{if $refURL}}
								<a href="{{$refURL}}">{{$entry.Name}}</a><span class="at">@</span><a class="cgit-sha" href="{{$refURL}}/commit/{{PathEscape $submodule.Commit.String}}">{{ShortSha $submodule.Commit.String}}</a>
							{{else}}
								{{$entry.Name}}<span class="at">@</span><span class="cgit-sha">{{ShortSha $submodule.Commit.String}}</span>
							{{end}}
						{{else if $entry.IsDir}}
							{{$subJumpablePathName := $entry.GetSubJumpablePathName}}
							<a class="cgit-dir" href="{{$.TreeLink}}/{{PathEscapeSegments $subJumpablePathName}}" title="{{$subJumpablePathName}}">{{$subJumpablePathName}}/</a>
						{{else}}
							<a href="{{$.TreeLink}}/{{PathEscapeSegments $entry.Name}}" title="{{$entry.Name}}">{{$entry.Name}}</a>
						{{end}}
					</span>
				</td>
				<td class="cgit-mode">{{if $entry.IsSubmodule}}m---------{{else if $entry.IsDir}}d---------{{else if $entry.IsLink}}lrwxrwxrwx{{else if $entry.IsExecutable}}-rwxr-xr-x{{else}}-rw-r--r--{{end}}</td>
				<td class="message cgit-desc">
					<span class="truncate">
						{{if $commit}}
							{{$commitLink := printf "%s/commit/%s" $.RepoLink (PathEscape $commit.ID.String)}}
							{{RenderCommitMessageLinkSubject $.Context $commit.Message $commitLink ($.Repository.ComposeMetas ctx)}}
						{{else}}
							<div class="ui active tiny slow centered inline"></div>
						{{end}}
					</span>
				</td>
				<td class="cgit-size cgit-right">{{if not (or $entry.IsDir $entry.IsSubmodule)}}{{ctx.Locale.TrSize $entry.Size}}{{end}}</td>
				<td class="age cgit-age cgit-right">{{if $commit}}{{DateUtils.TimeSince $commit.Committer.When}}{{end}}</td>
			</tr>
		{{end}}
	</tbody>
</table>
{{if and .ReadmeExist (or .IsMarkup .IsPlainText)}}
	{{template "repo/view_file" .}}
{{end}}
