{{if and (not .HideRepoInfo) (not .IsBlame)}}
<div class="cgit-summary repository-summary">
	{{if and (.Permission.CanRead $.UnitTypeCode) (not .IsEmptyRepo)}}
		<a class="{{if .PageIsCommits}}active{{end}}" href="{{.RepoLink}}/commits/{{.BranchNameSubURL}}">{{ctx.Locale.TrPluralString .CommitsCount "counters.n_commits" (printf "<b>%s</b>" (ctx.Locale.PrettyNumber .CommitsCount) | TrustHTML)}}</a>
		<span class="cgit-sep">·</span>
		<a class="{{if .PageIsBranches}}active{{end}}" href="{{.RepoLink}}/branches">{{ctx.Locale.TrPluralString .BranchesCount "counters.n_branches" (printf "<b>%s</b>" (ctx.Locale.PrettyNumber .BranchesCount) | TrustHTML)}}</a>
		<span class="cgit-sep">·</span>
		<a class="{{if .PageIsTagList}}active{{end}}" href="{{.RepoLink}}/tags">{{ctx.Locale.TrPluralString .NumTags "counters.n_tags" (printf "<b>%s</b>" (ctx.Locale.PrettyNumber .NumTags) | TrustHTML)}}</a>
		<span class="cgit-sep">·</span>
		{{$fileSizeFields := ctx.Locale.TrSize .Repository.Size}}
		<span {{if not (eq .Repository.Size 0)}}data-tooltip-content="{{.Repository.SizeDetailsString ctx.Locale}}"{{end}} data-test-name="repo-size"><b>{{$fileSizeFields.PrettyNumber}}</b> {{$fileSizeFields.TranslatedUnit}}</span>
		{{if .LanguageStats}}
			<span class="cgit-sep">·</span>
			<span class="cgit-langs">
				{{range $i, $l := .LanguageStats}}{{if $i}}, {{end}}<span><i class="color-icon" style="background-color: {{$l.Color}}"></i>{{if eq $l.Language "other"}}{{ctx.Locale.Tr "repo.language_other"}}{{else}}{{$l.Language}}{{end}} {{$l.Percentage}}%</span>{{end}}
			</span>
		{{end}}
	{{end}}
</div>
{{end}}
