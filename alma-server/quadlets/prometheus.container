[Unit]
Description=Prometheus
Wants=node-exporter.service podman-exporter.service clickhouse.service
After=node-exporter.service podman-exporter.service

[Container]
Image=docker.io/prom/prometheus:v3
ContainerName=prometheus
Network=monitoring.network
PublishPort=127.0.0.1:9090:9090
AddHost=host.loopback:169.254.1.3
Volume=%h/.config/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro,Z
Volume=/srv/prometheus/data:/prometheus:Z
Exec=--config.file=/etc/prometheus/prometheus.yml --storage.tsdb.path=/prometheus --storage.tsdb.retention.time=30d --storage.tsdb.retention.size=10GB
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
