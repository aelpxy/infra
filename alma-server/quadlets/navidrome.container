[Unit]
Description=Navidrome

[Container]
Image=docker.io/deluan/navidrome:latest
ContainerName=navidrome
Network=navidrome.network
Environment=ND_SCANSCHEDULE=1h
Environment=ND_ENABLEINSIGHTSCOLLECTOR=false
Environment=ND_DEFAULTTHEME=Spotify-ish
Volume=/srv/navidrome/data:/data:Z
Volume=/storage/media/music:/music:ro
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
