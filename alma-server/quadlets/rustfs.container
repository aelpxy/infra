[Unit]
Description=RustFS

[Container]
Image=docker.io/rustfs/rustfs:1.0.3
ContainerName=rustfs
Network=rustfs.network
Network=monitoring.network
PublishPort=127.0.0.1:9002:9000
PublishPort=127.0.0.1:9003:9001
EnvironmentFile=%h/.config/rustfs/rustfs.env
Environment=RUSTFS_VOLUMES=/data
Environment=RUSTFS_ADDRESS=0.0.0.0:9000
Environment=RUSTFS_CONSOLE_ENABLE=true
Environment=RUSTFS_CONSOLE_ADDRESS=0.0.0.0:9001
Environment=RUSTFS_OBS_METRIC_ENDPOINT=http://prometheus:9090/api/v1/otlp/v1/metrics
Environment=RUSTFS_OBS_TRACES_EXPORT_ENABLED=false
Environment=RUSTFS_OBS_LOGS_EXPORT_ENABLED=false
Environment=OTEL_RESOURCE_ATTRIBUTES=rustfs.cluster.id=alma
Volume=/storage/s3:/data
Volume=/srv/rustfs/logs:/logs:Z
NoNewPrivileges=true
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
