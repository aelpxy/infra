[Unit]
Description=Grafana
Wants=prometheus.service
After=prometheus.service

[Container]
Image=docker.io/grafana/grafana:13.2
ContainerName=grafana
Network=monitoring.network
EnvironmentFile=%h/.config/grafana/grafana.env
Volume=/srv/grafana/data:/var/lib/grafana:Z
Volume=%h/.config/grafana/provisioning:/etc/grafana/provisioning:ro,Z
Volume=%h/.config/grafana/dashboards:/var/lib/grafana-dashboards:ro,Z
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
