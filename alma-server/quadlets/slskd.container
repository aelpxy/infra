[Unit]
Description=slskd

[Container]
Image=docker.io/slskd/slskd:latest
ContainerName=slskd
Network=slskd.network
EnvironmentFile=%h/.config/slskd/slskd.env
Environment=SLSKD_NO_HTTPS=true
Environment=SLSKD_REMOTE_CONFIGURATION=false
Environment=SLSKD_SHARED_DIR=/music
Environment=SLSKD_DOWNLOADS_DIR=/downloads
Environment=SLSKD_INCOMPLETE_DIR=/app/incomplete
Volume=/srv/slskd/app:/app:Z
Volume=/storage/media/music:/music:ro
Volume=/storage/media/music/soulseek:/downloads
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
